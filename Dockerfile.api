# Dockerfile for API service - uses 'api' target from main Dockerfile
# This is a wrapper that Railway can use with "Dockerfile Path"

# Build only the 'api' stage
FROM btc-predictor/build:api as builder

# Import full Dockerfile and build api target
# Railway will execute: docker build --file Dockerfile.api --target api
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/workers \
    POETRY_VERSION=2.3.3 \
    POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_CREATE=false

# Install Poetry and dependencies
RUN pip install --no-cache-dir --upgrade pip==26.1 && \
    pip install --no-cache-dir poetry==$POETRY_VERSION && \
    addgroup --system appgroup && adduser --system --ingroup appgroup appuser

WORKDIR /app

# Copy dependencies and source
COPY pyproject.toml poetry.lock* ./
COPY shared/ ./shared/
COPY api-service/ ./api-service/
COPY scripts/ ./scripts/
COPY entrypoint.sh ./

# Install dependencies (base + api group)
# Install main deps + api group, exclude dev deps
RUN poetry install --no-interaction --no-ansi --with api --without dev --no-root && \
    chmod +x /app/entrypoint.sh && \
    chown -R appuser:appgroup /app

USER appuser
CMD ["/app/entrypoint.sh"]
