# Intentionally NOT pinned by digest (unlike the production Dockerfile):
# dev images are rebuilt often and should always pick up the latest
# 3.13-slim patch release. See CLAUDE.md "Docker image hardening" for the
# pin/no-pin rationale.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    POETRY_VERSION=2.3.3 \
    POETRY_HOME=/opt/poetry \
    POETRY_VIRTUALENVS_CREATE=false

# Upgrade pip and install Poetry with security fixes
RUN pip install --no-cache-dir --upgrade pip==26.1 && \
    pip install --no-cache-dir poetry==$POETRY_VERSION && \
    addgroup --system appgroup && adduser --system --ingroup appgroup appuser

WORKDIR /app

# Copy root dependencies
COPY pyproject.toml poetry.lock* ./

# Copy shared package first (dependency)
COPY shared/ ./shared/

# Install root dependencies (including ml group: daily/weekly worker tests
# import ARIMA/LSTM/XGBoost models, which require statsmodels/tensorflow/xgboost)
RUN poetry install --no-interaction --no-ansi --no-root --with ml

# Copy API code (mounted as volume in dev, but needed for poetry install)
COPY api-service/ ./api/

# Install API dependencies
WORKDIR /app/api
RUN poetry install --no-interaction --no-ansi --no-root

WORKDIR /app

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
